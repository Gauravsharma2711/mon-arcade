# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key
*.keystore
*.secret
*.pfx
*.p12
credentials.json

# Node & Frontend / Contract Build
node_modules/
*/node_modules/
dist/
*/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
artifacts/
*/artifacts/
cache/
*/cache/
typechain/
typechain-types/

# Python & Backend
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
*.egg-info/

# Databases & Local State
*.sqlite
*.sqlite3
*.db
*.log
logs/

# IDE & OS Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
